# ── Backend ───────────────────────────────────────────────
# Backend alag repo mein hai: github.com/faiyaz950/cryptowithfinoai
# Local par wo 8000 par chalta hai. Deploy par apne Render backend ka URL
# daalein, bina trailing slash ke.
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# Ye dono usi backend ko point karte hain — alag services nahi hain.
# AI chat routes  : /api/chat, /api/models, /api/chart
# Trading routes  : /api/candles, /api/backtest, /api/screener, /api/orders
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_CRYPTO_API_URL=http://127.0.0.1:8000/api

# Server-side rewrite (next.config.ts) ke liye — browser ko expose nahi hota.
BACKEND_URL=http://127.0.0.1:8000
